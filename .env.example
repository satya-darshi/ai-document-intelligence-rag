APP_ENV=development
APP_NAME=AI Document Intelligence & RAG Platform
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
DATABASE_URL=postgresql+psycopg://raguser:ragpassword@postgres:5432/ragdb

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=document_chunks

# Cloud free-tier AI. Keep this project on Google's free tier if you want ₹0 spend.
# Create the key in Google AI Studio and never commit the real key to Git.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_THINKING_BUDGET=512
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=8

CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=8
RERANK_TOP_K=5
CACHE_TTL_SECONDS=300
MAX_UPLOAD_MB=20
